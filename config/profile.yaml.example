technical_skills:
  languages: ["Python", "PostgreSQL", "C++"]
  libraries_and_tools:
    - "NumPy"
    - "pandas"
    - "scikit-learn"
    - "PyTorch"
    - "Backtrader"
    - "Matplotlib"
    - "Plotly"
    - "Prometheus"
    - "Grafana"
    - "Redis"
    - "Docker"
    - "MLflow"
    - "TA-Lib"
    - "Interactive Brokers API"
  modern_cpp:
    - "templates"
    - "constexpr"
    - "low-latency multithreading (std::atomic, std::thread)"
    - "memory optimized design"
    - "async networking (Boost.Asio)"
    - "performance profiling/benchmarking (perf)"
  quantitative_methods:
    - "Market microstructure driven alpha research (order book, liquidity, imbalance, decay)"
    - "Execution-aware high frequency statistical and machine-learning models"
    - "Statistical arbitrage"
    - "Time-series forecasting"
    - "Monte Carlo simulations"
    - "Risk management (VaR, Expected Shortfall)"
    - "Turnover control & signal stability"

projects:
  - name: "Monte Carlo Simulations for VaR & Expected Shortfall"
    description: "Engineered Monte Carlo simulation engines in Python to model correlated asset returns, compute Value-at-Risk (VaR) and Expected Shortfall (CVaR) under fat-tailed distributions, and quantify tail-risk exposure for multi-asset portfolios."
    tags: ["Risk Management", "Monte Carlo", "VaR", "Python", "Derivatives"]
  - name: "Deep Learning for Financial Time Series (CQF Program)"
    description: "Implemented deep neural network architectures (PyTorch) to forecast financial asset returns; engineered non-linear features from price-volume sequences to outperform traditional ARIMA/GARCH statistical baselines."
    tags: ["Machine Learning", "Deep Learning", "Time Series", "PyTorch", "Alpha Research"]
  - name: "Algorithmic Trading Strategies (CQF Program)"
    description: "Designed and backtested execution-aware mean reversion and trend-following strategies using Python and Backtrader; modeled realistic transaction costs, slippage, and stop-loss rules to achieve consistent simulated Sharpe metrics."
    tags: ["Algorithmic Trading", "Backtesting", "Mean Reversion", "Trend Following", "Python"]

trading_skills:
  - "Designed, backtested, and deployed systematic trading strategies in Python with execution-aware logic and robust risk controls."
  - "Integrated strategies with broker APIs for order placement, monitoring, and real-time position management."
  - "Applied data processing and optimization techniques to improve signal stability, turnover control, and execution efficiency."
  - "Operated strategies in live trading environments, monitoring performance, latency, and risk metrics."

target_preferences:
  roles:
    - "Quantitative Researcher"
    - "Quantitative Trader"
    - "Quant Developer"
    - "MFT Trader"
    - "Algorithmic Trader"
    - "Financial Engineer"
    - "Systematic Trader"
  workplace_type: "Remote"
  minimum_match_score: 70

